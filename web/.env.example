# Existing project only when explicitly supplied. Local development never creates a cloud project.
APP_ENV=local
ADMIN_WEB_ORIGIN=http://127.0.0.1:13000
ADMIN_API_ORIGIN=http://127.0.0.1:18080
# Set existing Firebase web app config to enable Google sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional local-only Auth Emulator; never mix with a real project.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=
